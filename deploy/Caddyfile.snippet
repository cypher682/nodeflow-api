# Append this block to /opt/caddy/Caddyfile, then reload Caddy.
# The hostname is generated by sslip.io: <subdomain>.<ip-with-dashes>.sslip.io -> 141.148.69.94.
# No DNS record is needed. Caddy issues the certificate on the first request.
#
# handle blocks are mutually exclusive and evaluated top to bottom, so the first matching one wins.

nodeflow.141-148-69-94.sslip.io {
	encode zstd gzip

	# Bull Board (/admin/queues) has no authentication of its own — it exposes retry, drain and
	# delete on every queue. On a public hostname that is an open door, so the path is not routed
	# at all. Replace `respond` with `basic_auth` + a `caddy hash-password` hash if you want it
	# reachable from a browser.
	handle /admin/queues* {
		respond "Not found" 404
	}

	handle {
		reverse_proxy nodeflow-api:4000
	}
}
