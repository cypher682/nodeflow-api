# Template for /opt/apps/nodeflow/.env on the Oracle VM. Never commit the real file.
#
# The compose file supplies DATABASE_URL and REDIS_URL itself (pointing at the container names),
# so do not put localhost URLs here — they would be overridden anyway.
#
# Generate the two secrets with openssl rand -hex 24 / -hex 32: hex only, because
# POSTGRES_PASSWORD is interpolated into the connection string and @ : / would corrupt it.

# --- required ---
POSTGRES_USER=nodeflow
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=nodeflow

# --- application ---
NODE_ENV=production
API_BASE_URL=https://nodeflow.141-148-69-94.sslip.io
# Origin allowed to call the API from a browser (the demo UI). "*" would allow any site.
CORS_ORIGIN=https://cypher682.github.io
LOG_LEVEL=info
# local keeps uploads on the uploads volume; "s3" is not implemented yet.
STORAGE_PROVIDER=local
