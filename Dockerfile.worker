FROM node:20-alpine AS base
WORKDIR /app
COPY package*.json ./

FROM base AS deps
RUN npm install

FROM deps AS build
COPY . .
RUN npm run prisma:generate
RUN npm run build

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup -S nodeflow && adduser -S nodeflow -G nodeflow
COPY package*.json ./
RUN npm install --omit=dev
COPY --from=build /app/dist ./dist
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
# The worker imports services/files.service.ts, which imports lib/storage.ts and creates
# <cwd>/uploads at import time. It must be writable by nodeflow or startup logs an error.
RUN mkdir -p /app/uploads && chown -R nodeflow:nodeflow /app/uploads
USER nodeflow
CMD ["node", "dist/workers/index.js"]
